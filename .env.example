# ─────────────────────────────────────────────────────────────────────────────
# RestockRadar — environment variables
# Copy to .env.local for local development. Never commit real values.
# Reference: docs/architecture/development-workflow.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (exposed to the browser: only public values here) ───────────────
# Supabase API URL. Local: `npx supabase status` → API URL.
# Production project: https://zdittonhmveidzpyldhj.supabase.co
VITE_SUPABASE_URL=
# Supabase public key (anon / publishable). Dashboard → Project Settings → API keys.
VITE_SUPABASE_ANON_KEY=
# Public VAPID key for Web Push. Generate with `npm run vapid:generate` (story 4.1).
VITE_VAPID_PUBLIC_KEY=
# Geocoder (IGN Géoplateforme). Default is fine.
VITE_GEOCODER_URL=https://data.geopf.fr/geocodage
# local | preview | production
VITE_APP_ENV=local

# ── Edge Functions (local: supabase/functions/.env ; prod: `supabase secrets set`) ──
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@example.org
# Random 32-byte secret shared by pg_net/cron and internal Edge Functions.
# PUSH_WEBHOOK_SECRET=
# Public URL of the app (CORS, links in notifications).
# APP_URL=https://example.org
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.

# ── Supabase Vault (run once per environment, in SQL) ─────────────────────────
# select vault.create_secret('<SUPABASE_URL>/functions/v1/send-push',   'edge_send_push_url');
# select vault.create_secret('<SUPABASE_URL>/functions/v1/maintenance', 'edge_maintenance_url');
# select vault.create_secret('<PUSH_WEBHOOK_SECRET>',                    'push_webhook_secret');

# ── Node scripts (OSM import, demo seed) — set in your shell, never commit ────
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Configured in the Supabase dashboard (no env var) ─────────────────────────
# Auth → Providers: Google, Apple · Auth → URL configuration: redirect URLs
# Auth → SMTP (Resend): postponed, required before public launch (story 6.4)
